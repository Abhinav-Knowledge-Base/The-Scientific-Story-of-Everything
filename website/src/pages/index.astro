---
import Layout from '../layouts/Layout.astro';
import { getAllSeasons, getAllEpisodes } from '../lib/episodes';
import { withBase } from '../lib/base';

const seasons = getAllSeasons();
const allEpisodes = getAllEpisodes();

const featuredEpisodes = [
  allEpisodes.find((e) => e.slug === 'ep-01-before-the-beginning')!,
  allEpisodes.find((e) => e.slug === 'ep-02-the-big-bang')!,
  allEpisodes.find((e) => e.slug === 'ep-10-the-young-earth')!,
  allEpisodes.find((e) => e.slug === 'ep-11-the-first-life')!,
  allEpisodes.find((e) => e.slug === 'ep-18-the-cambrian-explosion')!,
  allEpisodes.find((e) => e.slug === 'ep-24-the-human-evolutionary-tree')!,
  allEpisodes.find((e) => e.slug === 'ep-30-the-axial-age')!,
  allEpisodes.find((e) => e.slug === 'ep-34-after-1940-a-connected-world')!,
].filter(Boolean);
---

<Layout
  title="The Scientific Story of Everything — How Did We Get Here?"
  description="One continuous, 13.8-billion-year causal story from the quantum dawn to modern global consciousness across 106 canonical chapters."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>All 106 Canonical Chapters Verified</span>
      </div>

      <h1 class="hero-title">The Scientific Story<br />of Everything</h1>
      <p class="hero-subtitle">How Did We Get Here?</p>

      <p class="hero-description">
        Most science media teaches isolated chapters: a documentary on dinosaurs, a lecture on quantum physics, or a special on artificial intelligence. 
        <strong>This project tells ONE STORY.</strong> An unbroken causal chain across 13.8 billion years—from the quantum dawn of spacetime to the global technological network of today.
      </p>

      <div class="hero-cta-group">
        <a href={withBase('/episodes/season-01/ep-01-before-the-beginning')} class="btn-primary">
          <span>Start the Journey (Chapter 1)</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href={withBase('/timeline')} class="btn-secondary">
          <span>Explore 13.8 Ga Timeline</span>
        </a>
        <a href="#seasons" class="btn-secondary">
          <span>Browse 4 Volumes</span>
        </a>
      </div>

      <!-- Stat Ticker -->
      <div class="stat-ticker-grid">
        <div class="stat-item">
          <div class="stat-value">13.8 Ga</div>
          <div class="stat-label">Cosmic Arc Span</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">106</div>
          <div class="stat-label">Canonical Chapters</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">4 Volumes</div>
          <div class="stat-label">Depth Architecture</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">4 Tiers</div>
          <div class="stat-label">Epistemic Evidence Ladder</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Timeline Scrubber & Epoch Filter -->
  <section class="container" style="margin-bottom: 60px;">
    <div class="timeline-scrubber">
      <div class="scrubber-header">
        <div>
          <h2 class="scrubber-title">Chronological Milestones</h2>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Jump directly to a pivotal epoch in cosmic and human history</p>
        </div>
        <a href={withBase('/timeline')} style="font-size: 0.85rem; font-weight: 600;">View Master Timeline &rarr;</a>
      </div>

      <div class="scrubber-epochs">
        <a href={withBase('/episodes/season-01/ep-01-before-the-beginning')} class="epoch-pill active">
          🌌 Quantum Spacetime (13.8 Ga)
        </a>
        <a href={withBase('/episodes/season-01/ep-06-the-first-stars')} class="epoch-pill">
          ✨ Cosmic Dawn & Stars (13.5 Ga)
        </a>
        <a href={withBase('/episodes/season-01/ep-10-the-young-earth')} class="epoch-pill">
          🪐 Earth & Moon Accretion (4.5 Ga)
        </a>
        <a href={withBase('/episodes/season-01/ep-11-the-first-life')} class="epoch-pill">
          🧬 Prebiotic Chemistry & LUCA (4.0 Ga)
        </a>
        <a href={withBase('/episodes/season-01/ep-15-the-great-oxygenation-event')} class="epoch-pill">
          💨 Oxygen & Eukaryotes (2.4 Ga)
        </a>
        <a href={withBase('/episodes/season-01/ep-18-the-cambrian-explosion')} class="epoch-pill">
          🦐 Cambrian Animal Explosion (541 Ma)
        </a>
        <a href={withBase('/episodes/season-01/ep-23-the-human-lineage-begins')} class="epoch-pill">
          🚶 Hominin Bipedalism (7 Ma)
        </a>
        <a href={withBase('/episodes/season-01/ep-29-the-cradles-of-civilization')} class="epoch-pill">
          🏛️ Agriculture & Cradles (5,000 BCE)
        </a>
        <a href={withBase('/episodes/season-01/ep-30-the-axial-age')} class="epoch-pill">
          📜 Axial Age Moral Philosophy (800 BCE)
        </a>
        <a href={withBase('/episodes/season-01/ep-33-the-last-five-hundred-years')} class="epoch-pill">
          🔬 The Scientific Revolution (1543 CE)
        </a>
        <a href={withBase('/episodes/season-04/ep-01-are-we-alone')} class="epoch-pill">
          🛸 Open Scientific Frontiers (Present+)
        </a>
      </div>
    </div>
  </section>

  <!-- The Four Seasons / Volumes -->
  <section id="seasons" class="container" style="margin-bottom: 80px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <h2 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; margin-bottom: 12px;">
        The Four Volumes of Time
      </h2>
      <p style="color: var(--text-secondary); max-width: 650px; margin: 0 auto;">
        From the broad 13.8-billion-year mental map to rigorous mechanism deep-dives, human cultural depth, and future existential boundaries.
      </p>
    </div>

    <div class="season-grid">
      {seasons.map((s) => (
        <a
          href={withBase(`/seasons/${s.slug}`)}
          class="season-card"
          style={`--season-color: ${s.color}; --season-accent: ${s.accent};`}
        >
          <div class="season-card-header">
            <span class="season-number-badge">Volume {s.number}</span>
            <span class="season-icon">{s.icon}</span>
          </div>

          <h3 class="season-card-title">{s.title}</h3>
          <div class="season-card-tagline">{s.tagline}</div>
          <p class="season-card-description">{s.description}</p>

          <div class="season-card-footer">
            <span>{s.episodeCount} Chapters</span>
            <span style="color: var(--gold-primary); font-weight: 600;">Browse Volume &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Epistemic Framework Section -->
  <section class="container" style="margin-bottom: 80px;">
    <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 40px;">
      <div style="max-width: 800px; margin: 0 auto; text-align: center; margin-bottom: 32px;">
        <span class="meta-pill" style="margin-bottom: 12px; display: inline-block;">Epistemic Integrity</span>
        <h2 style="font-family: var(--font-display); font-size: 2rem; font-weight: 700; margin-bottom: 12px;">
          The 4-Tier Evidence Ladder
        </h2>
        <p style="color: var(--text-secondary); font-size: 0.95rem;">
          Every single claim throughout this project is explicitly graded against our epistemological framework to protect wonder without falling into speculation.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
        <div style="padding: 20px; border-radius: 12px; background: rgba(16, 185, 129, 0.08); border-top: 3px solid var(--tier-1-fact);">
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--tier-1-fact); text-transform: uppercase; margin-bottom: 6px;">Level 1</div>
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 8px;">Established Fact</h3>
          <p style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.5;">Empirical consensus supported by multiple independent lines of direct experimental observation (13.8 Ga age, nucleosynthesis, natural selection).</p>
        </div>

        <div style="padding: 20px; border-radius: 12px; background: rgba(59, 130, 246, 0.08); border-top: 3px solid var(--tier-2-inference);">
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--tier-2-inference); text-transform: uppercase; margin-bottom: 6px;">Level 2</div>
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 8px;">Strong Inference</h3>
          <p style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.5;">The best current scientific model explaining robust converging indirect data (Endosymbiosis of mitochondria, heat death under dark energy).</p>
        </div>

        <div style="padding: 20px; border-radius: 12px; background: rgba(245, 158, 11, 0.08); border-top: 3px solid var(--tier-3-debate);">
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--tier-3-debate); text-transform: uppercase; margin-bottom: 6px;">Level 3</div>
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 8px;">Active Debate</h3>
          <p style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.5;">Competing, peer-reviewed models under active experimental testing (RNA World vs Hydrothermal Vents, exact climate sensitivity ECS).</p>
        </div>

        <div style="padding: 20px; border-radius: 12px; background: rgba(168, 85, 247, 0.08); border-top: 3px solid var(--tier-4-speculation);">
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--tier-4-speculation); text-transform: uppercase; margin-bottom: 6px;">Level 4</div>
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 8px;">Speculation</h3>
          <p style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.5;">Theoretically plausible hypotheses lacking empirical confirmation (Multiverse cosmologies, machine qualia, Big Rip phantom energy).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Milestone Chapters -->
  <section class="container" style="margin-bottom: 80px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 700;">
          Featured Milestone Chapters
        </h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">
          Crucial transitional thresholds connecting cosmic history to modern life
        </p>
      </div>
      <a href={withBase('/seasons/season-01')} style="font-weight: 600; font-size: 0.9rem;">
        View All Season 1 Chapters &rarr;
      </a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
      {featuredEpisodes.map((ep) => (
        <a
          href={withBase(`/episodes/${ep.seasonSlug}/${ep.slug}`)}
          style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 22px; display: flex; flex-direction: column; text-decoration: none; transition: all 0.2s ease;"
          class="featured-card"
        >
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span class="meta-pill season" style="font-size: 0.7rem;">{ep.seasonBadge} &middot; Ep {ep.epNum}</span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">{ep.readingMinutes} min read</span>
          </div>

          <h3 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 8px;">
            {ep.title}
          </h3>

          <p style="font-size: 0.85rem; font-style: italic; color: #fce7b2; margin-bottom: 16px; flex-grow: 1;">
            {ep.coreQuestion}
          </p>

          <div style="font-size: 0.8rem; color: var(--gold-primary); font-weight: 600; display: flex; align-items: center; gap: 6px;">
            <span>Read Chapter</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
